# ─── CARA SETUP ───────────────────────────────────────────────────────────────
# 1. Copy file ini ke .env.local untuk local development (Laragon)
# 2. .env di server production sudah diisi oleh tim devops
#
# .env.local  → dibaca saat pnpm dev / pnpm build (local)
# .env        → dibaca di server production (cPanel hosting)
#
# connection_limit=3  → max 3 koneksi DB aktif (hemat proses shared hosting)
# pool_timeout=10     → timeout 10 detik kalau pool penuh

# ─── LOCAL (Laragon) ──────────────────────────────────────────────────────────
# DATABASE_URL="mysql://root:@127.0.0.1:3306/amoechat_local?connection_limit=3&pool_timeout=10"

# ─── PRODUCTION (cPanel) ──────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME?connection_limit=3&pool_timeout=10"

NEXT_PUBLIC_SITE_URL="https://blog.amoechat.com"
CMS_ADMIN_EMAIL="admin@example.com"
CMS_ADMIN_PASSWORD="change-this-password"
CMS_SESSION_SECRET="change-this-secret-before-production"
SETTINGS_ENCRYPTION_KEY="change-this-independent-secret-before-production"
TRUST_PROXY_HEADERS="false"

# Stable Server Action key untuk self-hosted/cPanel.
# Generate sekali: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Simpan value yang sama di GitHub Secret NEXT_SERVER_ACTIONS_ENCRYPTION_KEY.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Cloudflare Turnstile (opsional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
